{
  "version": "2026.10.25",
  "description": "Ark Pixel 12px proportional OTF desktop fonts with language-specific glyph variants.",
  "homepage": "https://github.com/TakWolf/ark-pixel-font",
  "license": "OFL-1.1",
  "url": "https://github.com/TakWolf/ark-pixel-font/releases/download/2026.10.25/ark-pixel-font-12px-proportional-otf-v2026.10.25.zip",
  "hash": "1a5c194397b7b30685c2126df1c0f0183c14367befd2e6291c9b3184bc187fc7",
  "installer": {
    "script": [
      "param([switch]$Uninstall,[switch]$CheckOnly,[switch]$Cleanup)",
      "$ErrorActionPreference='Stop'",
      "if(-not $global) { throw 'This package only supports global fonts. Use administrator PowerShell and scoop install/update -g.' }",
      "",
      "function Read-FontU16([byte[]]$Bytes,[int]$Offset) { [int]$Bytes[$Offset] * 256 + [int]$Bytes[$Offset+1] }",
      "function Read-FontU32([byte[]]$Bytes,[int]$Offset) { [uint32]([uint64]$Bytes[$Offset] * 16777216 + [uint64]$Bytes[$Offset+1] * 65536 + [uint64]$Bytes[$Offset+2] * 256 + [uint64]$Bytes[$Offset+3]) }",
      "function Get-FontMetadata([string]$Path) {",
      "    $stream=[IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))",
      "    $reader=[IO.BinaryReader]::new($stream)",
      "    try {",
      "        $header=$reader.ReadBytes(12)",
      "        if($header.Length -ne 12) { return }",
      "        $signature=[Text.Encoding]::ASCII.GetString($header,0,4)",
      "        if((Read-FontU32 $header 0) -ne 65536 -and $signature -notin @('OTTO','true')) { return }",
      "        $count=Read-FontU16 $header 4",
      "        $directory=$reader.ReadBytes($count*16)",
      "        if($directory.Length -ne $count*16) { return }",
      "        $tables=@{}",
      "        for($i=0;$i -lt $count;$i++) {",
      "            $at=$i*16",
      "            $tag=[Text.Encoding]::ASCII.GetString($directory,$at,4)",
      "            if($tag -in @('name','head')) { $tables[$tag]=@((Read-FontU32 $directory ($at+8)),(Read-FontU32 $directory ($at+12))) }",
      "        }",
      "        if(-not $tables.ContainsKey('name') -or -not $tables.ContainsKey('head')) { return }",
      "        if($tables.name[1] -gt 1048576 -or $tables.name[0]+$tables.name[1] -gt $stream.Length) { return }",
      "        [void]$stream.Seek($tables.name[0],[IO.SeekOrigin]::Begin)",
      "        $names=$reader.ReadBytes($tables.name[1])",
      "        if($names.Length -lt 6) { return }",
      "        $records=Read-FontU16 $names 2",
      "        $strings=Read-FontU16 $names 4",
      "        $values=@{}",
      "        for($i=0;$i -lt $records;$i++) {",
      "            $at=6+$i*12",
      "            if($at+12 -gt $names.Length) { break }",
      "            $platform=Read-FontU16 $names $at",
      "            $language=Read-FontU16 $names ($at+4)",
      "            $id=Read-FontU16 $names ($at+6)",
      "            if($id -notin @(4,6) -or $platform -notin @(0,3)) { continue }",
      "            if($values.ContainsKey($id) -and $language -ne 1033) { continue }",
      "            $length=Read-FontU16 $names ($at+8)",
      "            $offset=$strings+(Read-FontU16 $names ($at+10))",
      "            if($offset+$length -le $names.Length) { $values[$id]=[Text.Encoding]::BigEndianUnicode.GetString($names,$offset,$length) }",
      "        }",
      "        if(-not $values[6]) { return }",
      "        [void]$stream.Seek($tables.head[0]+4,[IO.SeekOrigin]::Begin)",
      "        $revisionBytes=$reader.ReadBytes(4)",
      "        if($revisionBytes.Length -ne 4) { return }",
      "        $fullName=if($values[4]){$values[4]}else{$values[6]}",
      "        [pscustomobject]@{Path=[IO.Path]::GetFullPath($Path);Key=$values[6];Name=$fullName;Revision=(Read-FontU32 $revisionBytes 0);Kind=$(if($signature -eq 'OTTO'){'OpenType'}else{'TrueType'});Bytes=$stream.Length}",
      "    } finally { $reader.Dispose() }",
      "}",
      "function Get-FontRegistryEntries {",
      "    $machineRoot=Join-Path $env:WINDIR 'Fonts'",
      "    $userRoot=Join-Path $env:LOCALAPPDATA 'Microsoft\\Windows\\Fonts'",
      "    foreach($scope in @('HKLM','HKCU')) {",
      "        $keyPath=$scope+':\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
      "        if(-not(Test-Path -LiteralPath $keyPath)) { continue }",
      "        $key=Get-Item -LiteralPath $keyPath",
      "        foreach($name in $key.GetValueNames()) {",
      "            $value=$key.GetValue($name,$null,[Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
      "            if($value -isnot [string]) { continue }",
      "            $expanded=[Environment]::ExpandEnvironmentVariables($value)",
      "            if([IO.Path]::IsPathRooted($expanded)) { $path=[IO.Path]::GetFullPath($expanded) }",
      "            else {",
      "                $path=Join-Path $machineRoot $expanded",
      "                $userPath=Join-Path $userRoot $expanded",
      "                if($scope -eq 'HKCU' -and (Test-Path -LiteralPath $userPath)) { $path=$userPath }",
      "                $path=[IO.Path]::GetFullPath($path)",
      "            }",
      "            [pscustomobject]@{Scope=$scope;Key=$keyPath;Name=$name;Value=$value;Kind=[string]$key.GetValueKind($name);Path=$path}",
      "        }",
      "    }",
      "}",
      "function Get-InstalledFontState([string[]]$WantedKeys) {",
      "    $machineRoot=[IO.Path]::GetFullPath((Join-Path $env:WINDIR 'Fonts'))",
      "    $userRoot=[IO.Path]::GetFullPath((Join-Path $env:LOCALAPPDATA 'Microsoft\\Windows\\Fonts'))",
      "    $entries=@(Get-FontRegistryEntries)",
      "    $globalPaths=@{};foreach($entry in $entries|Where-Object Scope -eq 'HKLM'){$globalPaths[$entry.Path]=$true}",
      "    $paths=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    if(Test-Path -LiteralPath $machineRoot) { foreach($file in Get-ChildItem -LiteralPath $machineRoot -File -Force | Where-Object Extension -in @('.ttf','.otf')) { [void]$paths.Add($file.FullName) } }",
      "    foreach($entry in $entries) { if([IO.Path]::GetExtension($entry.Path) -in @('.ttf','.otf') -and (Test-Path -LiteralPath $entry.Path)) { [void]$paths.Add($entry.Path) } }",
      "    $fonts=@(foreach($path in $paths) {",
      "        try { $font=Get-FontMetadata $path } catch { throw ('Cannot inspect an installed font safely: '+$path) }",
      "        if($font -and $font.Key -in $WantedKeys) { $font }",
      "    })",
      "    [pscustomobject]@{Fonts=$fonts;Entries=$entries;GlobalPaths=$globalPaths;MachineRoot=$machineRoot;UserRoot=$userRoot}",
      "}",
      "function Get-FontPlan([object[]]$Sources,$State) {",
      "    $seen=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    $targets=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    $registryNames=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    foreach($source in $Sources) {",
      "        if(-not $seen.Add($source.Key)) { throw 'The font archive has duplicate internal font identities.' }",
      "        $matches=@($State.Fonts | Where-Object Key -ieq $source.Key)",
      "        $winner=@($matches | Sort-Object @{e='Revision';Descending=$true},@{e={ [IO.Path]::GetDirectoryName($_.Path) -ieq $State.MachineRoot };Descending=$true},@{e={$State.GlobalPaths.ContainsKey($_.Path)};Descending=$true}) | Select-Object -First 1",
      "        $sameContents=$null -ne $winner -and $winner.Path -ieq $source.Path",
      "        if($winner -and $winner.Revision -eq $source.Revision -and -not $sameContents -and $winner.Bytes -eq $source.Bytes) {",
      "            $sameContents=(Get-FileHash -LiteralPath $winner.Path -Algorithm SHA256).Hash -ceq (Get-FileHash -LiteralPath $source.Path -Algorithm SHA256).Hash",
      "        }",
      "        $useExisting=$null -ne $winner -and ($winner.Revision -gt $source.Revision -or ($winner.Revision -eq $source.Revision -and $sameContents))",
      "        $chosen=if($useExisting){$winner}else{$source}",
      "        $globalWinner=@($matches|Where-Object {[IO.Path]::GetDirectoryName($_.Path) -ieq $State.MachineRoot}|Sort-Object @{e={$State.GlobalPaths.ContainsKey($_.Path)};Descending=$true},@{e='Revision';Descending=$true})|Select-Object -First 1",
      "        $target=if($globalWinner){$globalWinner.Path}else{Join-Path $State.MachineRoot ([IO.Path]::GetFileName($chosen.Path))}",
      "        $aliases=@($State.Entries | Where-Object { $_.Path -in @($matches.Path) })",
      "        $obsolete=@($matches | Where-Object Path -ine $target)",
      "        $machineAliases=@($aliases | Where-Object { $_.Scope -eq 'HKLM' -and $_.Path -ieq $target })",
      "        $copy=$chosen.Path -ine $target",
      "        $change=$copy -or $machineAliases.Count -eq 0 -or $obsolete.Count -gt 0 -or @($aliases|Where-Object Scope -eq 'HKCU').Count -gt 0",
      "        $registryName=if(-not $copy -and $machineAliases.Count -gt 0){$machineAliases[0].Name}else{$chosen.Name+' ('+$chosen.Kind+')'}",
      "        if(-not $targets.Add($target)) { throw ('Archive fonts resolve to the same font destination: '+$target) }",
      "        if(-not $registryNames.Add($registryName)) { throw ('Archive fonts resolve to the same font registry name: '+$registryName) }",
      "        $conflict=@($State.Entries | Where-Object { $_.Scope -eq 'HKLM' -and $_.Name -ieq $registryName -and $_.Path -notin @($matches.Path) })",
      "        if($conflict.Count -gt 0) { throw ('A different installed font owns registry name: '+$registryName) }",
      "        if($copy -and (Test-Path -LiteralPath $target) -and $target -notin @($matches.Path)) { throw ('A different file already occupies font destination: '+$target) }",
      "        [pscustomobject]@{Action=$(if(-not $change){'Skip'}elseif($useExisting){'AdoptOrReconcile'}elseif($matches.Count){'Update'}else{'Install'});Source=$chosen.Path;Target=$target;Copy=$copy;RegistryName=$registryName;Aliases=$aliases;Obsolete=$obsolete}",
      "    }",
      "}",
      "",
      "function Initialize-FontNative {",
      "    if('ScoopFontLifecycleNativeV3' -as [type]){return}",
      "    Add-Type -TypeDefinition @'",
      "using System;",
      "using System.ComponentModel;",
      "using System.Runtime.InteropServices;",
      "public static class ScoopFontLifecycleNativeV3 {",
      "    [DllImport(\"gdi32.dll\",CharSet=CharSet.Unicode,ExactSpelling=true)]static extern bool RemoveFontResourceExW(string path,uint flags,IntPtr reserved);",
      "    [DllImport(\"gdi32.dll\",CharSet=CharSet.Unicode,ExactSpelling=true)]static extern int AddFontResourceExW(string path,uint flags,IntPtr reserved);",
      "    [DllImport(\"kernel32.dll\",CharSet=CharSet.Unicode,ExactSpelling=true,SetLastError=true)]static extern bool MoveFileExW(string source,string destination,uint flags);",
      "    [DllImport(\"user32.dll\",ExactSpelling=true,SetLastError=true)]static extern bool PostMessageW(IntPtr window,uint message,IntPtr wParam,IntPtr lParam);",
      "    public static int Unload(string path){int calls=0;while(RemoveFontResourceExW(path,0,IntPtr.Zero))calls++;return calls;}",
      "    public static void Load(string path){if(AddFontResourceExW(path,0,IntPtr.Zero)==0)throw new InvalidOperationException(\"Cannot load font: \"+path);}",
      "    public static void RemoveOnce(string path){if(!RemoveFontResourceExW(path,0,IntPtr.Zero))throw new InvalidOperationException(\"Cannot unload new font: \"+path);}",
      "    public static void Restore(string path,int calls){for(int i=0;i<calls;i++)Load(path);}",
      "    public static void QueueDelete(string path){if(!MoveFileExW(path,null,4))throw new Win32Exception(Marshal.GetLastWin32Error(),\"Cannot queue font cleanup: \"+path);}",
      "    public static bool Notify(){return PostMessageW(new IntPtr(0xffff),0x001d,IntPtr.Zero,IntPtr.Zero);}",
      "    [StructLayout(LayoutKind.Sequential)]struct RmProcess {public int Id;public System.Runtime.InteropServices.ComTypes.FILETIME Started;}",
      "    [StructLayout(LayoutKind.Sequential,CharSet=CharSet.Unicode)]struct RmInfo {",
      "        public RmProcess Process;",
      "        [MarshalAs(UnmanagedType.ByValTStr,SizeConst=256)]public string App;",
      "        [MarshalAs(UnmanagedType.ByValTStr,SizeConst=64)]public string Service;",
      "        public uint Type,Status,Session;",
      "        [MarshalAs(UnmanagedType.Bool)]public bool Restartable;",
      "    }",
      "    [DllImport(\"rstrtmgr.dll\",CharSet=CharSet.Unicode)]static extern int RmStartSession(out uint session,int flags,System.Text.StringBuilder key);",
      "    [DllImport(\"rstrtmgr.dll\",CharSet=CharSet.Unicode)]static extern int RmRegisterResources(uint session,uint files,string[] paths,uint apps,IntPtr processes,uint services,IntPtr names);",
      "    [DllImport(\"rstrtmgr.dll\",CharSet=CharSet.Unicode)]static extern int RmGetList(uint session,out uint needed,ref uint count,[In,Out] RmInfo[] apps,out uint reasons);",
      "    [DllImport(\"rstrtmgr.dll\")]static extern int RmEndSession(uint session);",
      "    public static string LockOwners(string path){",
      "        uint session;",
      "        if(RmStartSession(out session,0,new System.Text.StringBuilder(33))!=0)return \"\";",
      "        try{",
      "            if(RmRegisterResources(session,1,new string[]{path},0,IntPtr.Zero,0,IntPtr.Zero)!=0)return \"\";",
      "            uint needed,count=0,reasons;",
      "            if(RmGetList(session,out needed,ref count,null,out reasons)!=234 || needed==0)return \"\";",
      "            RmInfo[] apps=new RmInfo[needed];count=needed;",
      "            if(RmGetList(session,out needed,ref count,apps,out reasons)!=0)return \"\";",
      "            var names=new System.Collections.Generic.List<string>();",
      "            for(int i=0;i<count;i++)names.Add((String.IsNullOrWhiteSpace(apps[i].App)?\"Process\":apps[i].App)+\" (PID \"+apps[i].Process.Id+\")\");",
      "            return String.Join(\", \",names.ToArray());",
      "        }finally{RmEndSession(session);}",
      "    }",
      "}",
      "'@",
      "}",
      "function Clear-FontStaging([string[]]$Paths,[string[]]$Directories,[string]$Snapshot) {",
      "    $deleted=0;$queued=0;$manual=0",
      "    foreach($path in $Paths|Where-Object {$_}) {",
      "        if([IO.Path]::GetDirectoryName($path) -notin $Directories){throw 'Refusing cleanup outside the transaction directories.'}",
      "        if(-not(Test-Path -LiteralPath $path)){continue}",
      "        try{Remove-Item -LiteralPath $path;$deleted++}",
      "        catch {",
      "            if(-not(Test-Path -LiteralPath $path)){$deleted++;continue}",
      "            try{[ScoopFontLifecycleNativeV3]::QueueDelete($path);$queued++}",
      "            catch{$manual++;Write-Warning ('Font cleanup remains at '+$path+'. '+$_.Exception.Message)}",
      "        }",
      "    }",
      "    if($manual -eq 0) {",
      "        try {",
      "            if(Test-Path -LiteralPath $Snapshot){Remove-Item -LiteralPath $Snapshot}",
      "            foreach($directory in $Directories) {",
      "                if(-not(Test-Path -LiteralPath $directory)){continue}",
      "                if(@(Get-ChildItem -LiteralPath $directory -Force).Count -gt 0){[ScoopFontLifecycleNativeV3]::QueueDelete($directory)}else{Remove-Item -LiteralPath $directory}",
      "            }",
      "        }catch{Write-Warning ('Cleanup directory remains: '+$_.Exception.Message)}",
      "    }",
      "    if($queued -gt 0){Write-Warning ($queued.ToString()+' isolated old font files await a future Windows startup for cleanup. No restart was requested.')}",
      "    [pscustomobject]@{Deleted=$deleted;Queued=$queued;Manual=$manual}",
      "}",
      "",
      "function Write-FontRecovery([string]$Path,$Record,[switch]$Optional) {",
      "    try{[IO.File]::WriteAllText($Path,($Record|ConvertTo-Json -Depth 9),[Text.UTF8Encoding]::new($false))}",
      "    catch{if(-not $Optional){throw};Write-Warning ('Recovery record could not be updated: '+$Path)}",
      "}",
      "function Restore-FontChanges([object[]]$Files,[object[]]$Aliases,[Collections.Generic.List[string]]$Errors,[string[]]$Registered=@()) {",
      "    $byPath=@{}",
      "    foreach($item in $Files) {",
      "        $byPath[$item.Original]=$item",
      "        if($item.Moved){try{[IO.File]::Move($item.Staged,$item.Original);$item.Restored=$true}catch{$Errors.Add('Cannot restore '+$item.Original+': '+$_.Exception.Message)}}else{$item.Restored=$true}",
      "    }",
      "    $machineKey='HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
      "    foreach($name in $Registered){try{if($name -in (Get-Item -LiteralPath $machineKey).GetValueNames()){Remove-ItemProperty -LiteralPath $machineKey -Name $name -ErrorAction Stop}}catch{$Errors.Add($_.Exception.Message)}}",
      "    foreach($entry in $Aliases) {",
      "        if($byPath.ContainsKey($entry.Path) -and -not $byPath[$entry.Path].Restored){$Errors.Add('Alias not restored because original bytes could not be recovered: '+$entry.Name);continue}",
      "        try{New-ItemProperty -LiteralPath $entry.Key -Name $entry.Name -Value $entry.Value -PropertyType $entry.Kind -Force|Out-Null}catch{$Errors.Add($_.Exception.Message)}",
      "    }",
      "    foreach($item in $Files|Where-Object {$_.Restored -and $_.Unloaded -gt 0}){try{[ScoopFontLifecycleNativeV3]::Restore($item.Original,$item.Unloaded)}catch{$Errors.Add($_.Exception.Message)}}",
      "}",
      "",
      "function Apply-FontPlan([object[]]$Plans,$State) {",
      "    $changes=@($Plans|Where-Object Action -ne 'Skip')",
      "    $publish=@($changes|Where-Object Action -ne 'Remove')",
      "    if($changes.Count -eq 0){Write-Host ('Already installed: '+$Plans.Count+' fonts; no system files copied or registered.');return}",
      "    Initialize-FontNative",
      "    $machineKey='HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
      "    $aliases=@($changes|ForEach-Object Aliases|Sort-Object Key,Name -Unique)",
      "    $oldPaths=@(@($changes|ForEach-Object Obsolete|ForEach-Object Path)+@($changes|Where-Object {$_.Copy -and (Test-Path -LiteralPath $_.Target)}|ForEach-Object Target)|Where-Object {[IO.Path]::GetDirectoryName($_) -in @($State.MachineRoot,$State.UserRoot)}|Sort-Object -Unique)",
      "    $id=[Guid]::NewGuid().ToString('N')",
      "    $main=Join-Path $State.MachineRoot ('.scoop-removed-'+$id)",
      "    $directories=@($main)",
      "    $old=@(foreach($path in $oldPaths) {",
      "        $folder=Join-Path ([IO.Path]::GetDirectoryName($path)) ('.scoop-removed-'+$id)",
      "        if($folder -notin $directories){$directories+=$folder}",
      "        [pscustomobject]@{Original=$path;Staged=(Join-Path $folder ('old-'+[Guid]::NewGuid().ToString('N')+[IO.Path]::GetExtension($path)));Unloaded=0;Moved=$false;Restored=$false}",
      "    })",
      "    $copies=@(foreach($plan in $changes|Where-Object Copy) {",
      "        [pscustomobject]@{Source=$plan.Source;Target=$plan.Target;Ready=(Join-Path $main ('ready-'+[Guid]::NewGuid().ToString('N')+[IO.Path]::GetExtension($plan.Target)));Failed=(Join-Path $main ('failed-'+[Guid]::NewGuid().ToString('N')+[IO.Path]::GetExtension($plan.Target)));ReadyCreated=$false;Hash='';Published=$false}",
      "    })",
      "    $loads=@(foreach($plan in $publish) {",
      "        if($plan.Copy -or -not $State.GlobalPaths.ContainsKey($plan.Target)){[pscustomobject]@{Path=$plan.Target;Added=$false}}",
      "    })",
      "    $registered=[Collections.Generic.List[string]]::new()",
      "    $removed=[Collections.Generic.List[object]]::new()",
      "    foreach($folder in $directories){New-Item -Path $folder -ItemType Directory|Out-Null}",
      "    $snapshot=Join-Path $main 'recovery.json'",
      "    $record=[ordered]@{Operation='Reconcile';Old=$old;Copies=$copies;Aliases=$aliases;Removed=$removed;Registered=$registered;Loads=$loads;Committed=$false}",
      "    $step='preparing the recovery record';$activePath=$null",
      "    try {",
      "        Write-FontRecovery $snapshot $record",
      "        foreach($copy in $copies) {",
      "            $step='preparing '+$copy.Source;$activePath=$copy.Source",
      "            $output=[IO.File]::Open($copy.Ready,'CreateNew','Write','None')",
      "            $copy.ReadyCreated=$true",
      "            try{$inputStream=[IO.File]::Open($copy.Source,'Open','Read',([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete));try{$inputStream.CopyTo($output)}finally{$inputStream.Dispose()}}finally{$output.Dispose()}",
      "            $copy.Hash=(Get-FileHash -LiteralPath $copy.Ready).Hash",
      "        }",
      "        foreach($item in $old){$step='unloading '+$item.Original;$activePath=$item.Original;$item.Unloaded=[ScoopFontLifecycleNativeV3]::Unload($item.Original)}",
      "        Write-FontRecovery $snapshot $record",
      "        foreach($item in $old){$step='moving old font '+$item.Original;$activePath=$item.Original;[IO.File]::Move($item.Original,$item.Staged);$item.Moved=$true}",
      "        foreach($copy in $copies){$step='publishing '+$copy.Target;$activePath=$copy.Target;[IO.File]::Move($copy.Ready,$copy.Target);$copy.Published=$true}",
      "        $activePath=$null",
      "        foreach($entry in $aliases){$removed.Add($entry);Remove-ItemProperty -LiteralPath $entry.Key -Name $entry.Name}",
      "        if($publish.Count -and -not(Test-Path -LiteralPath $machineKey)){New-Item -Path $machineKey|Out-Null}",
      "        foreach($plan in $publish){$registered.Add($plan.RegistryName);New-ItemProperty -LiteralPath $machineKey -Name $plan.RegistryName -Value ([IO.Path]::GetFileName($plan.Target)) -PropertyType String -Force|Out-Null}",
      "        foreach($load in $loads){$step='loading '+$load.Path;$activePath=$load.Path;[ScoopFontLifecycleNativeV3]::Load($load.Path);$load.Added=$true}",
      "    } catch {",
      "        $failure=$_;$errors=[Collections.Generic.List[string]]::new()",
      "        foreach($load in $loads|Where-Object Added){try{[ScoopFontLifecycleNativeV3]::RemoveOnce($load.Path)}catch{$errors.Add($_.Exception.Message)}}",
      "        foreach($copy in $copies|Where-Object Published){try{if((Get-FileHash -LiteralPath $copy.Target).Hash -cne $copy.Hash){throw 'Canonical file contents changed unexpectedly.'};[IO.File]::Move($copy.Target,$copy.Failed)}catch{$errors.Add('Cannot isolate new file '+$copy.Target+': '+$_.Exception.Message)}}",
      "        Restore-FontChanges $old $removed $errors $registered",
      "        if(-not [ScoopFontLifecycleNativeV3]::Notify()){Write-Warning 'Font refresh notification failed; reopen applications to refresh font lists.'}",
      "        if($errors.Count -eq 0){[void](Clear-FontStaging @($copies|Where-Object ReadyCreated|ForEach-Object {$_.Ready;$_.Failed}) $directories $snapshot)}",
      "        else {",
      "            $record.RecoveryErrors=@($errors)",
      "            Write-FontRecovery $snapshot $record -Optional",
      "        }",
      "        $recovery=if($errors.Count -eq 0){'Rollback completed.'}else{'Recovery: '+$snapshot+'. Recovery errors: '+($errors -join '; ')}",
      "        $owners=''",
      "        if($activePath -and ($failure.Exception.GetBaseException().HResult -band 65535) -in @(5,32,33)){try{$owners=[ScoopFontLifecycleNativeV3]::LockOwners($activePath)}catch{}}",
      "        $hint=if($owners){' In use by: '+$owners+'. Save your work and close the relevant application before retrying.'}else{''}",
      "        throw ('Font transaction stopped while '+$step+': '+$failure.Exception.Message+'.'+$hint+' Resolve the reported file or registration error and retry. No restart was requested. '+$recovery)",
      "    }",
      "    $record.Committed=$true",
      "    Write-FontRecovery $snapshot $record -Optional",
      "    if(-not [ScoopFontLifecycleNativeV3]::Notify()){Write-Warning 'Font refresh notification failed; reopen applications to refresh font lists.'}",
      "    $cleanup=Clear-FontStaging @($old.Staged) $directories $snapshot",
      "    Write-Host ('Fonts reconciled globally: '+$changes.Count+'; already current: '+(@($Plans|Where-Object Action -eq 'Skip').Count)+'; old files deleted: '+$cleanup.Deleted+'; queued: '+$cleanup.Queued+'; manual cleanup: '+$cleanup.Manual)",
      "}",
      "",
      "function Get-FontRemovalPlan([object[]]$Sources,$State,[hashtable]$Keep) {",
      "    $limits=@{};foreach($font in $Sources){$limits[$font.Key]=[uint32]$font.Revision}",
      "    foreach($font in $State.Fonts) {",
      "        if($limits.ContainsKey($font.Key) -and -not $Keep.ContainsKey($font.Key) -and $font.Revision -le $limits[$font.Key] -and [IO.Path]::GetDirectoryName($font.Path) -ieq $State.MachineRoot) {",
      "            [pscustomobject]@{Action='Remove';Copy=$false;Target=$null;Obsolete=@($font);Aliases=@($State.Entries|Where-Object Path -ieq $font.Path)}",
      "        }",
      "    }",
      "}",
      "",
      "function Get-FontInventory([string]$Root) {",
      "    $rootPath=[IO.Path]::GetFullPath($Root).TrimEnd('\\')",
      "    $entries=(Get-Content -Raw -LiteralPath (Join-Path $rootPath '.font-inventory.json')|ConvertFrom-Json)",
      "    $keys=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    $paths=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)",
      "    if($entries.Count -eq 0){throw 'Font inventory is empty; no cleanup or uninstall was performed.'}",
      "    foreach($entry in $entries) {",
      "        if($entry.Key -isnot [string] -or -not $entry.Key.Trim() -or -not $keys.Add($entry.Key) -or [string]$entry.Revision -notmatch '^\\d+$'){throw 'Invalid or duplicate font inventory identity.'}",
      "        $entry.Revision=[uint32]$entry.Revision",
      "        if($entry.File -isnot [string] -or [IO.Path]::IsPathRooted($entry.File) -or [IO.Path]::GetExtension($entry.File) -notin @('.ttf','.otf')){throw 'Invalid font inventory filename.'}",
      "        $path=[IO.Path]::GetFullPath((Join-Path $rootPath $entry.File))",
      "        if(-not $path.StartsWith($rootPath+'\\',[StringComparison]::OrdinalIgnoreCase) -or -not $paths.Add($path)){throw 'Font inventory path escapes its package or is duplicated.'}",
      "        for($node=$path;$node -ine $rootPath;$node=[IO.Path]::GetDirectoryName($node)) {",
      "            if((Test-Path -LiteralPath $node) -and ((Get-Item -LiteralPath $node -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Refusing a font inventory path containing a reparse point.'}",
      "        }",
      "    }",
      "    $entries",
      "}",
      "function Write-FontRecord([string]$Path,[AllowNull()]$Text) {",
      "    if($null -eq $Text){if(Test-Path -LiteralPath $Path){Remove-Item -LiteralPath $Path};return}",
      "    $temporary=$Path+'.'+[Guid]::NewGuid().ToString('N')",
      "    try{[IO.File]::WriteAllText($temporary,$Text,[Text.UTF8Encoding]::new($false));Move-Item -LiteralPath $temporary -Destination $Path -Force}",
      "    finally{if(Test-Path -LiteralPath $temporary){Remove-Item -LiteralPath $temporary}}",
      "}",
      "function Get-FontOwners([string]$PackageRoot,[string]$PreviousVersion) {",
      "    foreach($folder in Get-ChildItem -LiteralPath ([IO.Path]::GetDirectoryName($PackageRoot)) -Directory -Force) {",
      "        $path=Join-Path $folder.FullName '.font-ownership.json'",
      "        $legacy=Join-Path $folder.FullName 'current'",
      "        if($folder.FullName -ieq $PackageRoot -and $PreviousVersion -match '^\\d+(\\.\\d+){1,3}$' -and -not(Test-Path -LiteralPath (Join-Path $legacy '.font-inventory.json'))){$legacy=Join-Path $folder.FullName $PreviousVersion}",
      "        $previous=$null;$keys=@{}",
      "        if(Test-Path -LiteralPath $path) {",
      "            if($folder.Attributes -band [IO.FileAttributes]::ReparsePoint){throw ('Unexpected font package link: '+$folder.FullName)}",
      "            $previous=[IO.File]::ReadAllText($path)",
      "            $record=ConvertFrom-Json -InputObject $previous",
      "            if($record -isnot [pscustomobject]){throw ('Invalid font ownership record: '+$path)}",
      "            foreach($property in $record.PSObject.Properties) {",
      "                if(-not $property.Name.Trim() -or [string]$property.Value -notmatch '^\\d+$'){throw ('Invalid font ownership identity: '+$path)}",
      "                $keys[$property.Name]=[uint32]$property.Value",
      "            }",
      "        } elseif(Test-Path -LiteralPath (Join-Path $legacy '.font-inventory.json')) {",
      "            foreach($entry in Get-FontInventory $legacy){$keys[$entry.Key]=$entry.Revision}",
      "        } elseif($folder.FullName -ine $PackageRoot){continue}",
      "        [pscustomobject]@{Path=$path;Previous=$previous;Keys=$keys;Legacy=($null -eq $previous -and $keys.Count -gt 0)}",
      "    }",
      "}",
      "function Save-FontInventory([object[]]$Sources,[string]$Root) {",
      "    $rootPath=[IO.Path]::GetFullPath($Root).TrimEnd('\\')",
      "    $entries=@(foreach($source in $Sources) {",
      "        if(-not $source.Path.StartsWith($rootPath+'\\',[StringComparison]::OrdinalIgnoreCase)){throw 'Archive font is outside its package directory.'}",
      "        [pscustomobject]@{File=$source.Path.Substring($rootPath.Length+1);Key=$source.Key;Revision=$source.Revision}",
      "    })",
      "    Write-FontRecord (Join-Path $rootPath '.font-inventory.json') (ConvertTo-Json -InputObject $entries -Depth 4)",
      "    [void]@(Get-FontInventory $rootPath)",
      "}",
      "function Get-ArchiveFontSources([string]$Root) {",
      "    Get-ChildItem -LiteralPath $Root -Recurse -File|Where-Object Extension -in @('.ttf','.otf')|ForEach-Object {",
      "        $info=Get-FontMetadata $_.FullName",
      "        if(-not $info){throw ('Cannot read an upstream desktop font: '+$_.FullName)}",
      "        $info",
      "    }",
      "}",
      "function Test-FontScoopState([string]$Root) {",
      "    try {",
      "        $saved=Get-Content -Raw -LiteralPath (Join-Path $Root 'scoop-manifest.json') -ErrorAction Stop|ConvertFrom-Json",
      "        $info=Get-Content -Raw -LiteralPath (Join-Path $Root 'scoop-install.json') -ErrorAction Stop|ConvertFrom-Json",
      "        return $saved.version -ceq $manifest.version -and ($saved.installer.script -join \"`n\") -ceq ($manifest.installer.script -join \"`n\") -and [bool]$info.architecture",
      "    }catch{return $false}",
      "}",
      "function Get-FontVersionRoot {",
      "    $versionRoot=[IO.Path]::GetFullPath($dir).TrimEnd('\\')",
      "    $versionItem=Get-Item -LiteralPath $versionRoot -Force",
      "    if($versionItem.Attributes -band [IO.FileAttributes]::ReparsePoint){",
      "        $target=[string]$versionItem.Target",
      "        if(-not [IO.Path]::IsPathRooted($target)){$target=Join-Path ([IO.Path]::GetDirectoryName($versionRoot)) $target}",
      "        $versionRoot=[IO.Path]::GetFullPath($target).TrimEnd('\\')",
      "    }",
      "    $packageRoot=[IO.Path]::GetDirectoryName($versionRoot)",
      "    if([IO.Path]::GetFileName($versionRoot) -cne [string]$manifest.version -or [IO.Path]::GetFileName($packageRoot) -ine $app -or ((Get-Item -LiteralPath $versionRoot -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) -or ((Get-Item -LiteralPath $packageRoot -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Unexpected physical font package directory.'}",
      "    $versionRoot",
      "}",
      "function Clear-FontPackageData {",
      "    $versionRoot=Get-FontVersionRoot",
      "    $packageRoot=[IO.Path]::GetDirectoryName($versionRoot)",
      "    $current=Join-Path $packageRoot 'current'",
      "    if(Test-Path -LiteralPath $current) {",
      "        $target=[string](Get-Item -LiteralPath $current -Force).Target",
      "        if(-not [IO.Path]::IsPathRooted($target)){$target=Join-Path $packageRoot $target}",
      "        if([IO.Path]::GetFullPath($target).TrimEnd('\\') -ine $versionRoot){throw 'Current does not point to the version being cleaned.'}",
      "    }",
      "    $entries=@(Get-FontInventory $versionRoot)",
      "    $state=Get-InstalledFontState @($entries.Key)",
      "    foreach($entry in $entries) {",
      "        $installed=@($state.Fonts|Where-Object {$_.Key -ieq $entry.Key -and $_.Revision -ge $entry.Revision -and [IO.Path]::GetDirectoryName($_.Path) -ieq $state.MachineRoot -and $state.GlobalPaths.ContainsKey($_.Path)})",
      "        if($installed.Count -eq 0){throw ('A globally registered font is missing; keeping installation sources: '+$entry.Key)}",
      "    }",
      "    # Scoop normally saves these after post_install. Save and verify them now so",
      "    # pruning cannot discard the only durable uninstall/update lifecycle.",
      "    if(-not(Test-FontScoopState $versionRoot)) {",
      "        save_installed_manifest $app $bucket $dir $url",
      "        save_install_info @{architecture=$architecture;url=$url;bucket=$bucket} $dir",
      "    }",
      "    if(-not(Test-FontScoopState $versionRoot)){throw 'New Scoop metadata was not saved correctly; keeping all installation data.'}",
      "    $removed=0",
      "    foreach($entry in $entries) {",
      "        $path=Join-Path $versionRoot $entry.File",
      "        if(Test-Path -LiteralPath $path){try{Remove-Item -LiteralPath $path -Force;$removed++}catch{Write-Warning ('Font source remains: '+$path+'. '+$_.Exception.Message)}}",
      "    }",
      "    $parents=@($entries|ForEach-Object {[IO.Path]::GetDirectoryName((Join-Path $versionRoot $_.File))}|Sort-Object Length -Descending -Unique)",
      "    foreach($parent in $parents) {",
      "        while($parent -ine $versionRoot -and (Test-Path -LiteralPath $parent) -and @(Get-ChildItem -LiteralPath $parent -Force).Count -eq 0){Remove-Item -LiteralPath $parent -Force;$parent=[IO.Path]::GetDirectoryName($parent)}",
      "    }",
      "    foreach($old in Get-ChildItem -LiteralPath $packageRoot -Directory -Force|Where-Object {$_.Name -match '^\\d+(\\.\\d+){1,3}$' -and $_.Name -cne [string]$manifest.version}) {",
      "        try {",
      "            $oldPath=[IO.Path]::GetFullPath($old.FullName)",
      "            if([IO.Path]::GetDirectoryName($oldPath) -ine $packageRoot -or ($old.Attributes -band [IO.FileAttributes]::ReparsePoint) -or @(Get-ChildItem -LiteralPath $oldPath -Recurse -Force|Where-Object {$_.Attributes -band [IO.FileAttributes]::ReparsePoint}).Count){throw 'Unexpected old-version reparse point or path.'}",
      "            Remove-Item -LiteralPath $oldPath -Recurse -Force",
      "        }catch{Write-Warning ('Old font version remains: '+$old.FullName+'. '+$_.Exception.Message)}",
      "    }",
      "    if($cachedir -and (Test-Path -LiteralPath $cachedir)) {",
      "        foreach($file in Get-ChildItem -LiteralPath $cachedir -File|Where-Object {$_.Name.StartsWith($app+'#',[StringComparison]::OrdinalIgnoreCase)}) {",
      "            try{Remove-Item -LiteralPath $file.FullName -Force}catch{Write-Warning ('Font download cache remains: '+$file.FullName)}",
      "        }",
      "    }",
      "    Write-Host ('Removed font installation sources: '+$removed+'; kept inventory and Scoop metadata.')",
      "}",
      "",
      "# A machine-wide lock covers only font/state work; Scoop downloads stay parallel.",
      "$lockKey=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes(([IO.Path]::GetFullPath((Join-Path $env:WINDIR 'Fonts'))).ToUpperInvariant())).Replace('/','_')",
      "$mutex=[Threading.Mutex]::new($false,('Global\\ScoopFonts-'+$lockKey));$locked=$false",
      "try {",
      "    if(-not $CheckOnly) {",
      "        try{$locked=$mutex.WaitOne(0)}catch [Threading.AbandonedMutexException]{$locked=$true}",
      "        if(-not $locked){Write-Host 'Waiting for another global font operation...';try{$locked=$mutex.WaitOne(60000)}catch [Threading.AbandonedMutexException]{$locked=$true}}",
      "        if(-not $locked){throw 'Another global font operation is still running; retry after it completes.'}",
      "    }",
      "    if($Cleanup){try{Clear-FontPackageData}catch{Write-Warning ('Font package cleanup stopped: '+$_.Exception.Message)};return}",
      "    $inventory=Join-Path $dir '.font-inventory.json'",
      "    if(($Uninstall -or $CheckOnly) -and (Test-Path -LiteralPath $inventory)){$sources=@(Get-FontInventory $dir)}else{$sources=@(Get-ArchiveFontSources $dir)}",
      "    if($sources.Count -eq 0){throw 'No desktop fonts or valid inventory were found. Keep package data and repair the manifest.'}",
      "    if($CheckOnly){[void](Get-InstalledFontState @($sources.Key));return}",
      "    $versionRoot=Get-FontVersionRoot",
      "    $packageRoot=[IO.Path]::GetDirectoryName($versionRoot)",
      "    $owners=@(Get-FontOwners $packageRoot $old_version)",
      "    $own=$owners|Where-Object Path -ieq (Join-Path $packageRoot '.font-ownership.json')",
      "    $keep=@{};foreach($owner in $owners|Where-Object {$_.Path -ine $own.Path}){foreach($key in $owner.Keys.Keys){$keep[$key]=$owner.Keys[$key]}}",
      "    $next=@{}",
      "    if(-not $Uninstall) {",
      "        foreach($font in $sources){$next[$font.Key]=[uint32]$font.Revision;foreach($owner in $owners){if($owner.Keys.ContainsKey($font.Key) -and $owner.Keys[$font.Key] -gt $next[$font.Key]){$next[$font.Key]=$owner.Keys[$font.Key]}}}",
      "    }",
      "    $retired=@(foreach($key in $own.Keys.Keys){if(-not $next.ContainsKey($key)){[pscustomobject]@{Key=$key;Revision=$own.Keys[$key]}}})",
      "    # A legacy/source-only uninstall still works before its first ownership record.",
      "    if($Uninstall -and $null -eq $own.Previous -and $retired.Count -eq 0){$retired=$sources}",
      "    $involved=@($sources.Key)+@($retired.Key)",
      "    foreach($peer in $owners|Where-Object {$_.Path -ine $own.Path -and $_.Legacy}) {",
      "        if(@($peer.Keys.Keys|Where-Object {$_ -in $involved}).Count){throw ('An older font package shares these fonts: '+[IO.Path]::GetFileName([IO.Path]::GetDirectoryName($peer.Path))+'. Force-update or reinstall that package from the current bucket before using overlapping variants.')}",
      "    }",
      "    $state=Get-InstalledFontState @(@($sources.Key)+@($retired.Key)|Sort-Object -Unique)",
      "    $plans=@(if(-not $Uninstall){Get-FontPlan $sources $state};Get-FontRemovalPlan $retired $state $keep)",
      "    $records=[Collections.Generic.List[object]]::new()",
      "    $records.Add([pscustomobject]@{Path=$own.Path;Previous=$own.Previous;Text=(ConvertTo-Json -InputObject $next -Compress)})",
      "    # Hand the deletion limit to remaining owners before releasing shared faces.",
      "    foreach($owner in $owners|Where-Object {$_.Path -ine $own.Path}) {",
      "        $changed=$false",
      "        foreach($font in $retired){if($owner.Keys.ContainsKey($font.Key) -and $owner.Keys[$font.Key] -lt $font.Revision){$owner.Keys[$font.Key]=$font.Revision;$changed=$true}}",
      "        if($changed){$records.Add([pscustomobject]@{Path=$owner.Path;Previous=$owner.Previous;Text=(ConvertTo-Json -InputObject $owner.Keys -Compress)})}",
      "    }",
      "    $previous=if(Test-Path -LiteralPath $inventory){[IO.File]::ReadAllText($inventory)}else{$null}",
      "    try {",
      "        if(-not $Uninstall){Save-FontInventory $sources $dir}",
      "        foreach($record in $records){Write-FontRecord $record.Path $record.Text}",
      "        Apply-FontPlan $plans $state",
      "    } catch {",
      "        $failure=$_",
      "        foreach($record in $records){try{Write-FontRecord $record.Path $record.Previous}catch{Write-Warning ('Font ownership could not be restored: '+$record.Path)}}",
      "        if(-not $Uninstall){try{Write-FontRecord $inventory $previous}catch{Write-Warning ('Previous inventory could not be restored: '+$inventory)}}",
      "        throw $failure",
      "    }",
      "} finally {if($locked){$mutex.ReleaseMutex()};$mutex.Dispose()}"
    ]
  },
  "uninstaller": {
    "script": [
      "if($cmd -ne 'update') { & ([scriptblock]::Create(($manifest.installer.script -join [Environment]::NewLine))) -Uninstall }"
    ]
  },
  "pre_uninstall": [
    "if($cmd -eq 'update') { & ([scriptblock]::Create(($manifest.installer.script -join [Environment]::NewLine))) -CheckOnly }"
  ],
  "checkver": {
    "github": "https://github.com/TakWolf/ark-pixel-font"
  },
  "autoupdate": {
    "url": "https://github.com/TakWolf/ark-pixel-font/releases/download/$version/ark-pixel-font-12px-proportional-otf-v$version.zip"
  },
  "post_install": [
    "& ([scriptblock]::Create(($manifest.installer.script -join [Environment]::NewLine))) -Cleanup"
  ]
}
